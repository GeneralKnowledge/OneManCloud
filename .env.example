# Operator token for the control plane (also set as Wrangler secret OPERATOR_TOKEN)
OPERATOR_TOKEN=change-me-to-a-long-random-string

# Control plane URL used by the CLI and node agent
OMC_URL=http://127.0.0.1:8787

# Optional: override CLI config path
# OMC_CONFIG=~/.omc/config.json

# Optional: heartbeat timeout in seconds (default 90)
# HEARTBEAT_TIMEOUT_SECONDS=90

# Optional: base domain for public apps (no hard-coded domain)
# BASE_DOMAIN=example.com
