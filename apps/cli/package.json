{
  "name": "omc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "omc": "./bin/omc.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo 'no lint configured'",
    "start": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "@omc/agent": "workspace:*",
    "@omc/config": "workspace:*",
    "@omc/protocol": "workspace:*",
    "@omc/shared": "workspace:*",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
