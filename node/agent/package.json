    "start": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "@omc/config": "workspace:*",
    "@omc/protocol": "workspace:*",
    "@omc/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
